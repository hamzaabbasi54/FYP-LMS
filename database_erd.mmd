    plos ||--o{ clo_plo_mapping : "mapped from"
    courses ||--o{ course_clo_mapping : "maps CLOs"
    clos ||--o{ course_clo_mapping : "mapped to course"
    courses ||--o{ course_prerequisites : "has prerequisite"
    courses ||--o{ course_prerequisites : "is prerequisite of"
    courses ||--|| syllabi : "has syllabus"

