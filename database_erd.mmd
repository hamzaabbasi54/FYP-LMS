    semesters ||--o{ batch_semester_courses : "contains"
    courses ||--o{ batch_semester_courses : "assigned to"
    batches ||--o{ batch_plos : "targets"
    plos ||--o{ batch_plos : "targeted by"
    batches ||--o{ batch_clo_plo_mapping : "maps"
    clos ||--o{ batch_clo_plo_mapping : "mapped in batch"
    plos ||--o{ batch_clo_plo_mapping : "mapped in batch"

    %% --- Course Delivery ---
    semesters ||--o{ course_assignments : "delivers"
    courses ||--o{ course_assignments : "assigned in"
    users ||--o{ course_assignments : "teaches"
    course_assignments ||--o{ course_assignment_files : "has files"
    batches ||--o{ class_schedules : "schedules"
    courses ||--o{ class_schedules : "scheduled in"
    users ||--o{ class_schedules : "teaches"

    %% --- Students ---
    batches ||--o{ students : "enrolls"
    students ||--|| parents : "has parent"
    students ||--o{ enrollments : "enrolls in"
    course_assignments ||--o{ enrollments : "has enrolled"
    batches ||--o{ enrollments : "original batch"

    %% --- Assessments & Grades ---
    course_assignments ||--o{ assessments : "has"
    assessments ||--o{ assessment_questions : "contains"
    clos ||--o{ assessment_questions : "measured by"
    assessments ||--o{ assessment_clo_mapping : "maps CLOs"
    clos ||--o{ assessment_clo_mapping : "assessed by"
    assessments ||--o{ grades : "graded in"
    students ||--o{ grades : "receives"
    users ||--o{ grades : "graded by"
    assessments ||--o{ question_grades : "has"
    students ||--o{ question_grades : "receives"
    assessment_questions ||--o{ question_grades : "scored in"
    course_assignments ||--o{ attendance : "tracks"
    students ||--o{ attendance : "attends"

    %% --- Communication ---
    users ||--o{ messages : "sends"
    users ||--o{ messages : "receives"
    departments ||--o{ messages : "scoped to"
    users ||--o{ notifications : "notified"
