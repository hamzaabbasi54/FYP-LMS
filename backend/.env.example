# ============================================
# File: backend/.env.example
# FYP-LMS Environment Variables
# ============================================

# MySQL Database
DB_HOST=fyp-lms-hamza-abbasi.h.aivencloud.com
DB_USER=avnadmin
DB_PASS=db_password
DB_NAME=defaultdb
DB_PORT=13167
DB_SSL=true


# Server
PORT=3000

# JWT
JWT_SECRET=KEY

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend URL (used in welcome emails; defaults to http://localhost:5173 if unset)
# Set to your production frontend URL when deploying
FRONTEND_URL=http://localhost:5173

# Email (Gmail SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-digit-app-password
